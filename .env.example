# 在百炼控制台创建的北京地域 API Key。
DASHSCOPE_API_KEY=

# 北京地域共享域名。切换到业务空间专属域名时只需修改这里。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认文本模型。
DASHSCOPE_MODEL=qwen3.7-plus

# 千问图片模型使用百炼原生多模态接口。
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro-2026-06-22
DASHSCOPE_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_IMAGE_SIZE=2688*1536
